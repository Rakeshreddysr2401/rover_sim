<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rosmaster_x3">

    <xacro:property name="M_PI" value="3.1415926535897931" />

    <xacro:arg name="robot_name" default="rosmaster_x3"/>
    <xacro:arg name="prefix" default=""/>
    <xacro:arg name="use_gazebo" default="false"/>

    <xacro:include filename="$(find rover_description)/urdf/mech/rosmaster_x3_base.urdf.xacro"/>
    <xacro:include filename="$(find rover_description)/urdf/mech/mecanum_wheel.urdf.xacro"/>
    <xacro:include filename="$(find rover_description)/urdf/sensors/rgbd_camera.urdf.xacro"/>

    <xacro:rosmaster_x3_base prefix="$(arg prefix)"/>

    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="front_left"
      x_reflect="1"
      y_reflect="1"/>

    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="front_right"
      x_reflect="1"
      y_reflect="-1"/>

    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="back_left"
      x_reflect="-1"
      y_reflect="1"/>

    <xacro:mecanum_wheel
      prefix="$(arg prefix)"
      side="back_right"
      x_reflect="-1"
      y_reflect="-1"/>

    <!-- The only exteroceptive sensor, mirroring the real rover: a RealSense
         D555-style RGBD camera with its built-in IMU (topics /cam_1/*, /cam_1/imu).
         15 Hz / 8 m range: needed by depth-based mapping (nvblox) on the Jetson. -->
    <xacro:rgbd_camera
      prefix="$(arg prefix)"
      camera_name="cam_1"
      xyz_offset="0.105 0 0.05"
      rpy_offset="0 -0.50 0"
      update_rate="15"
      clip_far="8.0"/>

    <xacro:include filename="$(find rover_description)/urdf/control/velocity_control_plugin.urdf.xacro" />
    <xacro:load_velocity_control_plugin use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find rover_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro" />
    <xacro:load_gazebo_sim_ros2_control_plugin
      robot_name="$(arg robot_name)"
      use_gazebo="$(arg use_gazebo)"/>

    <xacro:include filename="$(find rover_description)/urdf/control/rosmaster_x3_ros2_control.urdf.xacro" />
    <xacro:rover_ros2_control
      prefix="$(arg prefix)"
      use_gazebo="$(arg use_gazebo)"/>


</robot>
